generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  userId       Int      @id @default(autoincrement()) @map("user_id")
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(50)
  phone        String?  @db.VarChar(20)
  status       String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  feePaymentsReceived         FeePayment[]             @relation("FeePaymentReceivedBy")
  createdTransactions         Transaction[]            @relation("TransactionCreatedBy")
  createdVouchers             Voucher[]                @relation("VoucherCreatedBy")
  approvedVouchers            Voucher[]                @relation("VoucherApprovedBy")
  createdInventoryTransactions InventoryTransaction[]  @relation("InventoryTransactionCreatedBy")
  notifications               Notification[]
  auditLogs                   AuditLog[]
  createdBackups              Backup[]

  @@map("users")
}

model Member {
  memberId   Int      @id @default(autoincrement()) @map("member_id")
  memberCode String   @unique @map("member_code") @db.VarChar(50)
  name       String   @db.VarChar(100)
  memberType String   @map("member_type") @db.VarChar(50)
  department String?  @db.VarChar(100)
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(150)
  address    String?  @db.Text
  status     String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  memberFees MemberFee[]

  @@map("members")
}

model FeeType {
  feeTypeId     Int      @id @default(autoincrement()) @map("fee_type_id")
  feeName       String   @map("fee_name") @db.VarChar(100)
  defaultAmount Decimal  @map("default_amount") @db.Decimal(12, 2)
  description   String?  @db.Text
  status        String   @db.VarChar(20)

  memberFees MemberFee[]

  @@map("fee_types")
}

model MemberFee {
  memberFeeId Int      @id @default(autoincrement()) @map("member_fee_id")
  memberId    Int      @map("member_id")
  feeTypeId   Int      @map("fee_type_id")
  amountDue   Decimal  @map("amount_due") @db.Decimal(12, 2)
  amountPaid  Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  fine        Decimal  @default(0) @db.Decimal(12, 2)
  dueDate     DateTime @map("due_date") @db.Date
  status      String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  member      Member       @relation(fields: [memberId], references: [memberId], onDelete: Restrict, onUpdate: Cascade)
  feeType     FeeType      @relation(fields: [feeTypeId], references: [feeTypeId], onDelete: Restrict, onUpdate: Cascade)
  feePayments FeePayment[]

  @@index([memberId])
  @@index([feeTypeId])
  @@map("member_fees")
}

model FeePayment {
  paymentId       Int      @id @default(autoincrement()) @map("payment_id")
  memberFeeId     Int      @map("member_fee_id")
  receiptNumber   String   @unique @map("receipt_number") @db.VarChar(50)
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(30)
  paymentDate     DateTime @default(now()) @map("payment_date")
  referenceNumber String?  @map("reference_number") @db.VarChar(100)
  receivedBy      Int      @map("received_by")
  remarks         String?  @db.Text

  memberFee MemberFee @relation(fields: [memberFeeId], references: [memberFeeId], onDelete: Restrict, onUpdate: Cascade)
  receiver  User      @relation("FeePaymentReceivedBy", fields: [receivedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([memberFeeId])
  @@index([receivedBy])
  @@map("fee_payments")
}

model Account {
  accountId      Int      @id @default(autoincrement()) @map("account_id")
  accountName    String   @map("account_name") @db.VarChar(100)
  accountType    String   @map("account_type") @db.VarChar(50)
  accountNumber  String?  @map("account_number") @db.VarChar(100)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(15, 2)
  status         String   @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  transactionId     Int      @id @default(autoincrement()) @map("transaction_id")
  transactionNumber String   @unique @map("transaction_number") @db.VarChar(50)
  accountId         Int      @map("account_id")
  transactionType   String   @map("transaction_type") @db.VarChar(30)
  category          String?  @db.VarChar(100)
  amount            Decimal  @db.Decimal(15, 2)
  description       String?  @db.Text
  referenceNumber   String?  @map("reference_number") @db.VarChar(100)
  transactionDate   DateTime @default(now()) @map("transaction_date")
  status            String   @db.VarChar(20)
  createdBy         Int      @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  account  Account   @relation(fields: [accountId], references: [accountId], onDelete: Restrict, onUpdate: Cascade)
  creator  User      @relation("TransactionCreatedBy", fields: [createdBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  vouchers Voucher[]

  @@index([accountId])
  @@index([createdBy])
  @@index([transactionDate])
  @@map("transactions")
}

model Voucher {
  voucherId      Int       @id @default(autoincrement()) @map("voucher_id")
  voucherNumber  String    @unique @map("voucher_number") @db.VarChar(50)
  transactionId  Int       @map("transaction_id")
  voucherType    String    @map("voucher_type") @db.VarChar(30)
  amount         Decimal   @db.Decimal(15, 2)
  description    String?   @db.Text
  photoPath      String?   @map("photo_path") @db.VarChar(255)
  photoName      String?   @map("photo_name") @db.VarChar(255)
  photoType      String?   @map("photo_type") @db.VarChar(50)
  status         String    @db.VarChar(20)
  createdBy      Int       @map("created_by")
  approvedBy     Int?      @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [transactionId], onDelete: Restrict, onUpdate: Cascade)
  creator     User        @relation("VoucherCreatedBy", fields: [createdBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  approver    User?       @relation("VoucherApprovedBy", fields: [approvedBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([transactionId])
  @@index([createdBy])
  @@index([approvedBy])
  @@map("vouchers")
}

model Category {
  categoryId   Int      @id @default(autoincrement()) @map("category_id")
  categoryName String   @unique @map("category_name") @db.VarChar(100)
  description  String?  @db.Text
  status       String   @db.VarChar(20)

  items Item[]

  @@map("categories")
}

model Item {
  itemId          Int      @id @default(autoincrement()) @map("item_id")
  itemCode        String   @unique @map("item_code") @db.VarChar(50)
  itemName        String   @map("item_name") @db.VarChar(100)
  categoryId      Int      @map("category_id")
  unit            String   @db.VarChar(30)
  quantity        Decimal  @default(0) @db.Decimal(12, 2)
  minimumQuantity Decimal  @default(0) @map("minimum_quantity") @db.Decimal(12, 2)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  description     String?  @db.Text
  status          String   @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category              Category              @relation(fields: [categoryId], references: [categoryId], onDelete: Restrict, onUpdate: Cascade)
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@map("items")
}

model InventoryTransaction {
  inventoryTransactionId Int      @id @default(autoincrement()) @map("inventory_transaction_id")
  itemId                Int      @map("item_id")
  transactionType       String   @map("transaction_type") @db.VarChar(30)
  quantity              Decimal  @db.Decimal(12, 2)
  unitPrice             Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalAmount           Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  transactionDate       DateTime @default(now()) @map("transaction_date")
  referenceNumber       String?  @map("reference_number") @db.VarChar(100)
  remarks               String?  @db.Text
  createdBy             Int      @map("created_by")
  createdAt             DateTime @default(now()) @map("created_at")

  item    Item @relation(fields: [itemId], references: [itemId], onDelete: Restrict, onUpdate: Cascade)
  creator User @relation("InventoryTransactionCreatedBy", fields: [createdBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([itemId])
  @@index([createdBy])
  @@index([transactionDate])
  @@map("inventory_transactions")
}

model Notification {
  notificationId   Int       @id @default(autoincrement()) @map("notification_id")
  userId           Int       @map("user_id")
  title            String    @db.VarChar(150)
  message          String    @db.Text
  notificationType String?   @map("notification_type") @db.VarChar(50)
  isRead           Boolean   @default(false) @map("is_read")
  createdAt        DateTime  @default(now()) @map("created_at")
  readAt           DateTime? @map("read_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  logId       Int       @id @default(autoincrement()) @map("log_id")
  userId      Int       @map("user_id")
  action      String    @db.VarChar(50)
  tableName   String    @map("table_name") @db.VarChar(100)
  recordId    Int?      @map("record_id")
  description String?   @db.Text
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Backup {
  backupId   Int      @id @default(autoincrement()) @map("backup_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  filePath   String   @map("file_path") @db.VarChar(255)
  backupType String   @map("backup_type") @db.VarChar(30)
  fileSize   BigInt?  @map("file_size")
  status     String   @db.VarChar(20)
  createdBy  Int      @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [createdBy], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdBy])
  @@map("backups")
}
